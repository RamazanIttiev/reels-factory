        {
          "kind": "bar",
          "at": 14.0,
          "text": "your cookies go along",
          "icon": "cookie",
          "until": 15.4
        },
        {
          "kind": "bar",
          "at": 15.4,
          "text": "server sees valid login",
          "icon": "key",
          "until": 16.8
        },
        {
          "kind": "bar",
          "at": 16.8,
          "text": "carries out the action",
