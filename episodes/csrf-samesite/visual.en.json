          "kind": "bar",
          "at": 1.4,
          "text": "CSRF = forged request",
          "icon": "siren",
          "until": 3.7
        },
        {
          "kind": "bar",
          "at": 3.7,
          "text": "attacker's own page",
          "icon": "globe",
          "until": 6.2
