          "until": 19.4
        },
        {
          "kind": "bar",
          "at": 19.4,
          "text": "you never clicked",
          "icon": "mouse-pointer-click"
        }
      ]
    },
    {
      "id": "fix",
      "type": "media",
      "title": "The *SameSite* cookie flag",
      "accent": "#C6F135",
      "stat": {
        "label": "cross-site cookies",
        "value": "not sent"
      },
      "badge": {
        "icon": "shield",
        "text": "SAMESITE"
      },
      "layers": [
        {
          "kind": "code",
          "at": 0.3,
          "code": "Set-Cookie: session=abc;\n  SameSite=Strict",
          "mark": "SameSite=Strict"
        },
        {
          "kind": "card",
          "at": 7.0,
          "icon": "lock",
          "title": "Request from another site",
          "value": "no cookie",
          "status": "BLOCKED",
          "tone": "good"
        },
        {
          "kind": "bar",
          "at": 1.4,
          "text": "the fix lives in the cookie",
          "icon": "cookie",
          "until": 2.6
        },
        {
          "kind": "bar",
          "at": 2.6,
          "text": "SameSite attribute",
          "icon": "settings",
          "until": 3.9
        },
        {
          "kind": "bar",
          "at": 3.9,
          "text": "controls when cookie is sent",
          "icon": "clock",
          "until": 5.2
        },
        {
          "kind": "bar",
          "at": 5.2,
          "text": "browser decides",
          "icon": "eye",
          "until": 6.4
        },
        {
          "kind": "bar",
          "at": 6.4,
          "text": "cross-site request?",
          "icon": "globe",
          "until": 8.4
        },
        {
          "kind": "bar",
          "at": 8.4,
          "text": "Strict value",
          "icon": "shield",
          "until": 9.8
        },
        {
          "kind": "bar",
          "at": 9.8,
          "text": "no cross-site cookies",
          "icon": "ban",
          "until": 11.2
        },
        {
          "kind": "bar",
          "at": 11.2,
          "text": "not in any request",
          "icon": "lock",
          "until": 12.6
        },
        {
          "kind": "bar",
          "at": 12.6,
          "text": "other site: no cookie",
          "icon": "x",
          "until": 14.0
        },
        {
          "kind": "bar",
          "at": 14.0,
          "text": "some protection",
          "icon": "shield-check",
          "until": 15.4
        },
        {
          "kind": "bar",
          "at": 15.4,
          "text": "not a full answer",
          "icon": "siren",
          "until": 16.8
        },
        {
          "kind": "bar",
          "at": 16.8,
          "text": "use with other defenses",
          "icon": "layers",
          "until": 18.2
        },
        {
          "kind": "bar",
          "at": 18.2,
          "text": "CSRF tokens too",
          "icon": "key",
          "until": 19.2
        },
        {
          "kind": "bar",
          "at": 19.2,
          "text": "layers, not one fix",
          "icon": "check"
        }
      ]
    },
    {
      "id": "summary",
      "type": "media",
      "title": "Three *steps*",
      "accent": "#C6F135",
      "layers": [
        {
          "kind": "bar",
          "at": 0.3,
          "text": "1. another site sends it",
          "icon": "globe",
          "until": 1.3
        },
        {
          "kind": "bar",
          "at": 1.3,
          "text": "request to your bank",
          "icon": "send",
          "until": 2.6
        },
        {
          "kind": "bar",
          "at": 2.6,
          "text": "2. browser adds the cookie",
          "icon": "cookie",
          "until": 3.9
        },
        {
          "kind": "bar",
          "at": 3.9,
          "text": "3. SameSite cuts it off",
          "icon": "shield",
          "until": 5.2
        },
        {
          "kind": "bar",
          "at": 5.2,
          "text": "cookie blocked",
          "icon": "ban",
          "until": 6.4
        },
        {
          "kind": "bar",
          "at": 6.4,
          "text": "request refused",
          "icon": "lock"
        }
