        {
          "kind": "bar",
          "at": 9.8,
          "text": "random page asks",
          "icon": "globe",
          "until": 11.2
        },
        {
          "kind": "bar",
          "at": 11.2,
          "text": "your bank, quietly",
          "icon": "bank",
          "until": 12.6
