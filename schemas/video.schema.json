{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Published video record (one line in state/videos.jsonl)",
  "type": "object",
  "required": ["video_id","topic_id","slug","language","published_at","length_s","category","level","kind","hook_type","hook_text","visual","cta_type","voice_id","post_slot","phase","fact_sheet_hash","ai_label"],
  "properties": {
    "video_id": { "type": "string", "description": "our id, e.g. cloudflare-regex-outage.ru" },
    "topic_id": { "type": "integer" },
    "slug": { "type": "string" },
    "language": { "enum": ["ru","en"] },
    "ig_media_id": { "type": ["string","null"], "description": "returned by the publish call; needed to fetch insights later" },
    "published_at": { "type": "string", "format": "date-time" },
    "length_s": { "type": "number" },
    "word_count": { "type": "integer" },
    "category": { "type": "string" },
    "level": { "enum": ["mid","mid+"] },
    "kind": { "enum": ["incident","evergreen"] },
    "hook_type": { "type": "string" },
    "hook_text": { "type": "string" },
    "hook_words": { "type": "integer" },
    "hook_has_number": { "type": "boolean" },
    "hook_is_question": { "type": "boolean" },
    "visual": { "type": "string" },
    "opening_frame": { "type": "string" },
    "cta_type": { "type": "string" },
    "caption_style": { "type": "string" },
    "voice_id": { "type": "string" },
    "post_slot": { "type": "string" },
    "weekday": { "type": "integer", "minimum": 0, "maximum": 6 },
    "hashtags_count": { "type": "integer" },
    "caption_chars": { "type": "integer" },
    "phase": { "enum": ["explore","learn","exploit"] },
    "experiment_id": { "type": ["string","null"] },
    "hypothesis": { "type": ["string","null"] },
    "fact_sheet_hash": { "type": "string", "description": "hash of facts/<slug>.json at publish time" },
    "approved_by": { "enum": ["human","auto"] },
    "human_edits_count": { "type": "integer" },
    "ai_label": { "type": "boolean" }
  }
}
